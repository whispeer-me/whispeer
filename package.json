    "happy-dom": "^21.0.4",
    "node-pg-migrate": "^6.2.2",
    "nuxt": "^3.21.11",
    "sass": "^1.70.0",
    "sass-loader": "^14.0.0",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-router": "^4.2.5"
  },
